/*
 * BFD profile overrides for the Exophiala pre-annotated dataset.
 *
 * Applied ON TOP OF conf/profile_BFD.config (which sets -profile BFD loads).
 * Override values use absolute paths since launchDir refers to the pipeline
 * root under -profile BFD, not the working directory where this run lives.
 *
 * Key overrides vs conf/profile_BFD.config:
 *
 *   run_setup = false
 *     INPUT_SETUP is disabled — files are already in input/dna & input/pep
 *     using the {Genus}_{species}_{strain} naming convention that
 *     makeSampleTag() constructs from samples.csv. All 11 genomes match.
 *
 *   pep_dir / genome_dir / outdir / genome_stats_outdir
 *     Point at the Exophiala working directory so results land next to the data.
 *
 *   run_intergenic / run_gene_stats / run_asm_stats / run_busco_*
 *     Disabled — no GFF3 or CDS files available, ASMID column is synthetic
 *     placeholders only, and BUSCO is too expensive for 11 genomes without need.
 *
 *   skip_merge = true
 *     Per-tool merge tables are skipped. Enable with --skip_merge false to
 *     build cross-run merge tables from results/function/<tool>/.
 *
 *   All nine protein-only functional annotation tools (pfam, cazy, merops,
 *     signalp, tmhmm, targetp, idp, wolfpsort, predgpi) are enabled.
 */

params {
    run_setup = false

    // Absolute paths to the Exophiala working directory
    pep_dir             = "/bigdata/stajichlab/shared/projects/CIFAR_E4D/SSF_PRB_Fungal_Genomes/compare/Exophiala/input/pep"
    cds_dir             = "/bigdata/stajichlab/shared/projects/CIFAR_E4D/SSF_PRB_Fungal_Genomes/compare/Exophiala/input/cds"
    gff_dir             = "/bigdata/stajichlab/shared/projects/CIFAR_E4D/SSF_PRB_Fungal_Genomes/compare/Exophiala/input/gff3"
    trna_dir            = "/bigdata/stajichlab/shared/projects/CIFAR_E4D/SSF_PRB_Fungal_Genomes/compare/Exophiala/input/trna"
    genome_dir          = "/bigdata/stajichlab/shared/projects/CIFAR_E4D/SSF_PRB_Fungal_Genomes/compare/Exophiala/input/dna"
    outdir              = "/bigdata/stajichlab/shared/projects/CIFAR_E4D/SSF_PRB_Fungal_Genomes/compare/Exophiala/results/function"
    stats_outdir        = "/bigdata/stajichlab/shared/projects/CIFAR_E4D/SSF_PRB_Fungal_Genomes/compare/Exophiala/results/seqstats"
    genome_stats_outdir = "/bigdata/stajichlab/shared/projects/CIFAR_E4D/SSF_PRB_Fungal_Genomes/compare/Exophiala/results/genome_stats"

    // Skip ASM-dependent and GFF3/CDS-dependent steps (no GFF3/ASMID real data)
    skip_merge         = true
    run_intergenic     = false
    run_gene_stats     = false
    run_asm_stats      = false
    run_busco_genome   = false
    run_busco_pep      = false

    // All nine protein-only functional annotation tools: ON
    run_pfam      = true
    run_cazy      = true
    run_merops    = true
    run_signalp   = true
    run_tmhmm     = true
    run_targetp   = true
    run_idp       = true
    run_wolfpsort = true
    run_predgpi   = true

    // Genome stats that need only proteins: ON
    run_aa_freq    = true
    run_codon_freq = true
}
